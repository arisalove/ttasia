# ---- Supabase ----
# Create a free project at https://supabase.com (or run `supabase start` locally with the Supabase CLI)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- Demo mode ----
# When true (or when Supabase vars above are missing), TapTap runs against the
# in-memory seeded demo repository instead of Supabase — useful for kicking the
# tyres with zero setup. Set to "false" once Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Payments (modular adapter; demo mode never claims a real charge) ----
PAYMENT_PROVIDER=manual
# Placeholder for a future FPX / gateway integration:
# FPX_MERCHANT_ID=
# FPX_SECRET_KEY=
